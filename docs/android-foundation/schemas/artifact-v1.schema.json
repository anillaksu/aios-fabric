{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schema/artifact/v1",
  "title": "AIOS Artifact v1",
  "description": "Canonical, machine-readable AIOS artifact manifest. Design-only until a real signer/builder produces one — see docs/android-foundation/01-AUDIT.md.",
  "type": "object",
  "required": [
    "artifactId", "type", "version", "platform", "minRuntime",
    "capabilities", "dependencies", "sha256", "signature",
    "provenance", "buildId", "createdAt", "status", "evidenceRefs"
  ],
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^art-[0-9a-f]{16,64}$",
      "description": "Deterministic: 'art-' + sha256(canonicalJson({type, version, platform, buildId})) truncated/full, matching desktop/observer.mjs hashing convention."
    },
    "type": {
      "type": "string",
      "enum": [
        "core-native", "runtime-service", "node-agent", "control-surface",
        "evidence-vault", "artifact-store", "installer", "secrets-boundary",
        "capability-bridge", "catalog"
      ]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$" },
    "platform": { "type": "string", "enum": ["android"] },
    "minRuntime": { "type": "string", "description": "Minimum Android runtime service version required, semver range" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Must be a subset of capabilities in VERIFIED or AVAILABLE state — see 06-SECURITY-BOUNDARY.md Part 7 table. An artifact declaring an unproven capability fails catalog validation."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactId", "versionRange"],
        "properties": {
          "artifactId": { "type": "string" },
          "versionRange": { "type": "string" }
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value", "keyRef"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519", "rsa-pss-sha256"] },
        "value": { "type": "string", "description": "base64" },
        "keyRef": { "type": "string", "description": "Indirect reference — never the raw public/private key material inline" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["builtBy", "buildHostDigest", "sourceCommit"],
      "properties": {
        "builtBy": { "type": "string" },
        "buildHostDigest": { "type": "string" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "buildId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": [
        "DISCOVERED", "VERIFIED", "AVAILABLE", "INSTALLED",
        "ACTIVE", "SUPERSEDED", "ROLLED_BACK", "REVOKED"
      ]
    },
    "rollbackTarget": {
      "type": ["string", "null"],
      "description": "artifactId of the previously ACTIVE version this artifact would roll back to, computed at install time"
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "References into the local Evidence Vault (projection of canonical EvidenceLedger), not a second canonical source"
    }
  }
}
